# Our own source keeps LF in the repository and in the working tree, so behavior does not depend on
# which machine checked it out.
* text=auto eol=lf

# The supplied content packages are byte-addressed: each `learning-release.json` and
# `package-manifest.json` carries a SHA-256 for every file, and the importer verifies them. Any
# line-ending conversion here changes those bytes and breaks every hash. Every received drop lives
# under content/releases/, so one rule protects them all. Leave these directories untouched.
content/releases/** -text

*.zip binary
*.png binary
*.jpg binary

# The salvaged authoring transcript is kept exactly as exported, CRLF included.
docs/authoring/history/** -text
