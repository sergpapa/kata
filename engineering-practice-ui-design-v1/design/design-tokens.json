{
  "schema": "Project-specific extracted token inventory; not a claim of DTCG conformance",
  "source": "reference-source/app/globals.css",
  "default_color_scheme": "light",
  "css_custom_properties": {
    "--background": "#f5f7fc",
    "--foreground": "#19233e",
    "--card": "#ffffff",
    "--card-foreground": "#19233e",
    "--popover": "#ffffff",
    "--popover-foreground": "#19233e",
    "--primary": "#3349b3",
    "--primary-foreground": "#ffffff",
    "--secondary": "#e9edf9",
    "--secondary-foreground": "#233880",
    "--muted": "#eef1f8",
    "--muted-foreground": "#57627c",
    "--accent": "#e9edf9",
    "--accent-foreground": "#233880",
    "--destructive": "#b12d3f",
    "--border": "#dde3ef",
    "--input": "#c8d1e4",
    "--ring": "#546acc",
    "--chart-1": "#3349b3",
    "--chart-2": "#526bc7",
    "--chart-3": "#abc947",
    "--chart-4": "#b16d20",
    "--chart-5": "#55717b",
    "--radius": "0.6rem",
    "--sidebar": "#17233f",
    "--sidebar-foreground": "#f2f5ff",
    "--sidebar-primary": "#d5ef77",
    "--sidebar-primary-foreground": "#17233f",
    "--sidebar-accent": "#2a3a60",
    "--sidebar-accent-foreground": "#ffffff",
    "--sidebar-border": "#334264",
    "--sidebar-ring": "#d5ef77"
  },
  "fonts": {
    "--font-sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif",
    "--font-mono": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, \"Liberation Mono\", \"Courier New\", monospace"
  },
  "component_base_declarations": {
    "body": {
      "margin": "0",
      "background": "var(--background)",
      "color": "var(--foreground)",
      "font-family": "var(--font-sans)",
      "font-size": "1rem",
      "line-height": "1.65"
    },
    "h1": {
      "font-size": "clamp(1.8rem, 2.5vw, 2.65rem)",
      "font-weight": "650",
      "margin-bottom": ".6rem"
    },
    "h2": {
      "font-size": "1.35rem",
      "font-weight": "650",
      "margin-bottom": ".9rem"
    },
    "h3": {
      "font-size": "1.05rem",
      "font-weight": "650",
      "margin": "1.3rem 0 .65rem"
    },
    ".brand": {
      "display": "flex",
      "flex-direction": "row",
      "align-items": "center",
      "gap": ".85rem",
      "padding": "1.7rem 1.5rem 2.25rem",
      "font-size": "1.2rem",
      "font-weight": "650",
      "line-height": "1.25",
      "letter-spacing": "-.02em"
    },
    ".brand-mark": {
      "display": "grid",
      "place-items": "center",
      "width": "2.7rem",
      "height": "2.7rem",
      "border-radius": "7px",
      "color": "#d7ef81",
      "background": "#2c3d60"
    },
    ".nav-button": {
      "min-height": "3rem",
      "padding": ".7rem .85rem",
      "gap": ".85rem",
      "font-size": ".9375rem",
      "color": "#c7d2e9",
      "border-radius": "6px"
    },
    ".topbar": {
      "display": "flex",
      "justify-content": "space-between",
      "align-items": "center",
      "gap": "1rem",
      "padding": ".8rem 2.1rem",
      "background": "var(--card)",
      "border-bottom": "1px solid var(--border)",
      "min-height": "4.45rem"
    },
    ".page-content": {
      "width": "100%",
      "max-width": "1500px",
      "margin": "0 auto",
      "padding": "2.45rem 2.5rem 3rem",
      "flex": "1"
    },
    ".overview-grid": {
      "display": "grid",
      "grid-template-columns": "minmax(0,1.7fr) minmax(17rem,1fr)",
      "gap": "1.25rem"
    },
    ".continue-card": {
      "border-radius": "10px",
      "color": "#f9fbff",
      "background": "#23335a",
      "overflow": "hidden",
      "padding": "1.75rem 2rem 0",
      "display": "flex",
      "flex-direction": "column",
      "align-items": "flex-start"
    },
    ".lime-button": {
      "background": "#d7ef81",
      "color": "#25370f",
      "margin": ".35rem 0 1.65rem",
      "font-weight": "650"
    },
    ".card": {
      "background": "var(--card)",
      "border": "1px solid var(--border)",
      "border-radius": "9px",
      "padding": "1.65rem",
      "min-width": "0"
    },
    ".reader-grid": {
      "display": "grid",
      "grid-template-columns": "minmax(0,1.8fr) minmax(18rem,1fr)",
      "gap": "1.5rem",
      "align-items": "start"
    },
    ".lesson-reader": {
      "padding": "2rem"
    },
    ".prose": {
      "font-size": "1rem",
      "line-height": "1.85",
      "color": "#35415b",
      "overflow-wrap": "anywhere"
    },
    ".lesson-row": {
      "display": "flex",
      "align-items": "center",
      "gap": "1rem",
      "width": "100%",
      "padding": "1rem 1.5rem",
      "text-align": "left",
      "transition": "background .15s"
    },
    ".reader-aside": {
      "display": "flex",
      "flex-direction": "column",
      "gap": "1.5rem"
    },
    ".wide-sheet": {
      "width": "min(100vw,32rem)",
      "max-width": "32rem!important",
      "overflow-y": "auto",
      "background": "var(--card)"
    },
    ":focus-visible": {
      "outline": "3px solid var(--ring)",
      "outline-offset": "3px"
    }
  },
  "sidebar": {
    "workspace_width": "15.5rem",
    "mobile_width": "18rem",
    "mobile_breakpoint_px": 768,
    "primitive_default_width": "16rem"
  },
  "media_queries": [
    "(min-width:768px) ",
    "(max-width:1150px) ",
    "(max-width:900px) ",
    "(max-width:767px) ",
    "(prefers-reduced-motion:reduce) "
  ],
  "usage": "Merge these values and the matching component styles into the target app. Preserve the responsive rules in the full stylesheet."
}
