{
  "name": "educode",
  "private": true,
  "version": "0.1.0",
  "description": "Local learning application for the authored HTTP lesson releases",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/server",
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev -w @educode/server\" \"npm:dev -w @educode/web\"",
    "build": "npm run build -w @educode/web && npm run build -w @educode/server",
    "start": "npm run start -w @educode/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty && npm run typecheck -w @educode/web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "screenshots": "node tools/screenshots.mjs",
    "release:seed": "tsx apps/server/src/authoring/main.ts seed",
    "release:build": "tsx apps/server/src/authoring/main.ts build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "axe-core": "4.10.2",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
